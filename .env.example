# ----------------------------------------------------------------------------
# Map-VN environment variables
# ----------------------------------------------------------------------------
# Copy to .env.local and fill in real values. See PHASE_2_SETUP.md for setup.
# ----------------------------------------------------------------------------

# Production: https://vn-map-go.vercel.app (no trailing slash)
# Used as auth callback base — must match Supabase "Site URL" in dashboard
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Map tiles: MapLibre + CartoCDN is default — no token needed.
# Only set if you swap to Mapbox GL.
# NEXT_PUBLIC_MAPBOX_TOKEN=

# ---- Supabase (Phase 2 backend) --------------------------------------------
# Project URL — from Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Anon (public) key — safe to expose to browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY, full DB access. Used by seed scripts and
# trusted server actions. NEVER expose to browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI (Phase 3) ----------------------------------------------------------
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---- Analytics / misc ------------------------------------------------------
PLAUSIBLE_DOMAIN=
REVALIDATE_SECRET=
